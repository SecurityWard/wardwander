---
type Props = { class?: string };
const { class: className } = Astro.props;
---

<div
  class:list={["flex items-center gap-3", className]}
  role="separator"
  aria-hidden="true"
>
  <span class="from-border h-px flex-1 bg-linear-to-l to-transparent"></span>
  <span class="bg-accent block size-2 rotate-45"></span>
  <span class="from-border h-px flex-1 bg-linear-to-r to-transparent"></span>
</div>
