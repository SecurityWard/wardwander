---
import Rule from "@/components/Rule.astro";
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="pt-10 pb-8 sm:pt-16">
      <p class="label-caps mb-4">Skylar Simmons &#183; est. 2026</p>
      <h1 class="font-display my-2 text-5xl leading-none sm:text-7xl">
        Ward<span class="text-accent italic">&amp;</span>Wander
      </h1>
      <p
        class="font-display text-muted-foreground mt-4 text-xl italic sm:text-2xl"
      >
        Security, games, and the space between.
      </p>
      <p class="mt-6 max-w-2xl">
        Notes on offensive security, cyber deception, and red teaming from one
        side of the table; tabletop RPG design, zines, and terrain builds from
        the other. The entries worth reading are the ones where the two overlap.
      </p>
      <div class="mt-6 flex items-center gap-x-4">
        <Socials />
        <a
          target="_blank"
          href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
          class="label-caps hover:text-accent inline-flex items-center gap-x-1"
          aria-label="RSS Feed"
          title="RSS Feed"
        >
          <IconRss width={14} height={14} class="stroke-current stroke-2" />
          RSS
        </a>
      </div>
    </section>

    <Rule class="" />

    {
      featuredPosts.length > 0 && (
        <section id="featured" class="pt-10 pb-4">
          <h2 class="label-caps">{t.home.featured}</h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-10 pb-4">
          <h2 class="label-caps">{t.home.recentPosts}</h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton
        class="font-display hover:text-accent text-lg"
        href={getRelativeLocaleUrl(locale, "posts")}
      >
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
